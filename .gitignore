node_modules/
__pycache__/
*.pyc

# Fetch output. Stays out of git: it is large, it is restored by re-fetching from the
# operators, and nothing derives from git history here. dist/ IS committed — it is
# regenerated from raw/ in seconds, gated by the checker, and it is the only way GitHub
# Pages can serve it.
data/raw/

# Half-written files from an interrupted atomic write. They are removed by the writer
# itself; this is belt and braces so one can never be committed.
.tmp-*
